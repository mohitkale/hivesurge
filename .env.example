# Hive Surge M4 sandbox backend (Supabase FREE tier). Copy to .env.local and fill in.
# Only the public project URL and the public anon / publishable key belong here.
# NEVER put a service_role / secret key in any VITE_ variable: Vite ships them to the browser.
# With both unset the game runs fully offline (guest play, local save, mock cloud).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
